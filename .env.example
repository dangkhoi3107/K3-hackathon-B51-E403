# Cấu hình backend (codebase/server/) — copy file này thành ".env" (bỏ ".example"),
# điền key thật vào rồi lưu. File ".env" đã có trong .gitignore, không bao giờ commit.

# --- Gemini — BẮT BUỘC, mọi tính năng AI (chat, agent, vector search) đều cần key này ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- OpenRouter — TUỲ CHỌN, chỉ cần nếu muốn dùng provider OpenRouter trong app ---
# Để trống vẫn chạy bình thường với riêng Gemini; chọn OpenRouter trên giao diện mà
# thiếu key này sẽ báo lỗi rõ ràng (401), không phải app hỏng.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Server ---
PORT=8787
